// Version resource (included from HashCalc.rc).
// The numbers come from version.h, which build.bat updates.
#include "version.h"

#ifndef VER_DESCRIPTION
#define VER_DESCRIPTION "HashCalc - file and text hash calculator"
#endif
#ifndef VER_FILENAME
#define VER_FILENAME "HashCalc.exe"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_MAJOR, VERSION_MINOR, 0, 0
 PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, 0, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", VER_DESCRIPTION
            VALUE "FileVersion", VERSION_STR
            VALUE "InternalName", "HashCalc"
            VALUE "OriginalFilename", VER_FILENAME
            VALUE "ProductName", "HashCalc"
            VALUE "ProductVersion", VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
