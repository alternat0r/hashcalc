#include "resource.h"
#include <windows.h>
#include <commctrl.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#include "version.rc2"

// File and window icon (also shown next to the Explorer context menu entries).
// The first icon resource is the one Explorer shows for the .exe.
IDI_APP ICON "HashCalc.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open File...\tCtrl+O",              IDM_FILE_OPEN
        MENUITEM "Hash &Folder...\tCtrl+Shift+O",      IDM_FILE_FOLDER
        MENUITEM SEPARATOR
        MENUITEM "&Copy All Results\tCtrl+Shift+C",    IDM_FILE_COPYALL
        MENUITEM "&Reset\tCtrl+R",                     IDM_FILE_RESET
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                              IDM_FILE_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&PE && Similarity Hashes",          IDM_VIEW_EXTENDED
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "Always on &Top\tCtrl+T",             IDM_SETTINGS_TOPMOST
        MENUITEM "&Single Instance",                   IDM_SETTINGS_SINGLE
        MENUITEM "Add to Explorer &Context Menu",      IDM_SETTINGS_SHELL
        MENUITEM "Add to &PATH (Command Line)...",     IDM_SETTINGS_PATH
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help\tF1",                          IDM_HELP_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About HashCalc",                    IDM_HELP_ABOUT
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "O",    IDM_FILE_OPEN,      VIRTKEY, CONTROL
    "O",    IDM_FILE_FOLDER,    VIRTKEY, CONTROL, SHIFT
    "C",    IDM_FILE_COPYALL,   VIRTKEY, CONTROL, SHIFT
    "T",    IDM_SETTINGS_TOPMOST, VIRTKEY, CONTROL
    "R",    IDM_FILE_RESET,     VIRTKEY, CONTROL
    VK_F1,  IDM_HELP_HELP,      VIRTKEY
END

// Compact layout: input, a grid of hash types, and a list with one row per
// ticked type. Resizable (the list grows); no maximize. The last grid row and
// the PE & similarity types are shown with View > PE & Similarity Hashes;
// when hidden, main.cpp moves everything below the grid up by one row.
IDD_HASHCALC DIALOGEX 0, 0, 268, 290
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_THICKFRAME
EXSTYLE WS_EX_ACCEPTFILES | WS_EX_APPWINDOW
CAPTION "HashCalc"
MENU IDR_MAINMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // --- Input -----------------------------------------------------------
    LTEXT           "Data Format:", IDC_STATIC, 7, 6, 52, 8
    COMBOBOX        IDC_DATAFORMAT, 7, 16, 52, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Data:", IDC_STATIC, 64, 6, 40, 8
    EDITTEXT        IDC_DATA, 64, 16, 178, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE, 245, 16, 16, 13

    AUTOCHECKBOX    "HMAC", IDC_HMAC, 7, 43, 52, 10
    LTEXT           "Key Format:", IDC_STATIC, 64, 32, 50, 8
    COMBOBOX        IDC_KEYFORMAT, 64, 41, 50, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Key:", IDC_STATIC, 118, 32, 40, 8
    EDITTEXT        IDC_KEY, 118, 41, 143, 13, ES_AUTOHSCROLL

    // --- Hash types (grid, 4 columns) ---------------------------------------
    CONTROL         "All", IDC_CHK_ALL, "Button", BS_3STATE | WS_TABSTOP, 7, 57, 30, 10
    CONTROL         "", IDC_SEP_TOP, "Static", SS_ETCHEDHORZ, 40, 62, 177, 1
    PUSHBUTTON      "Copy All", IDC_COPY_ALL, 221, 55, 40, 12
    AUTOCHECKBOX    "MD5", IDC_CHK_MD5, 7, 70, 60, 10
    AUTOCHECKBOX    "SHA1", IDC_CHK_SHA1, 72, 70, 60, 10
    AUTOCHECKBOX    "SHA256", IDC_CHK_SHA256, 137, 70, 60, 10
    AUTOCHECKBOX    "SHA384", IDC_CHK_SHA384, 202, 70, 60, 10
    AUTOCHECKBOX    "SHA512", IDC_CHK_SHA512, 7, 82, 60, 10
    AUTOCHECKBOX    "MD4", IDC_CHK_MD4, 72, 82, 60, 10
    AUTOCHECKBOX    "MD2", IDC_CHK_MD2, 137, 82, 60, 10
    AUTOCHECKBOX    "RIPEMD160", IDC_CHK_RIPEMD160, 202, 82, 60, 10
    AUTOCHECKBOX    "TIGER", IDC_CHK_TIGER, 7, 94, 60, 10
    AUTOCHECKBOX    "PANAMA", IDC_CHK_PANAMA, 72, 94, 60, 10
    AUTOCHECKBOX    "ADLER32", IDC_CHK_ADLER32, 137, 94, 60, 10
    AUTOCHECKBOX    "CRC32", IDC_CHK_CRC32, 202, 94, 60, 10
    AUTOCHECKBOX    "eDonkey", IDC_CHK_EDONKEY, 7, 106, 60, 10
    AUTOCHECKBOX    "Imphash", IDC_CHK_IMPHASH, 72, 106, 60, 10
    AUTOCHECKBOX    "Authentihash", IDC_CHK_AUTHENTIHASH, 137, 106, 60, 10
    AUTOCHECKBOX    "RichHash", IDC_CHK_RICHHASH, 202, 106, 60, 10
    AUTOCHECKBOX    "ssdeep", IDC_CHK_SSDEEP, 7, 118, 60, 10
    AUTOCHECKBOX    "TLSH", IDC_CHK_TLSH, 72, 118, 60, 10

    // --- Results: one row per ticked type -----------------------------------
    CONTROL         "", IDC_RESULTS, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 132, 254, 126

    // --- Bottom bar --------------------------------------------------------
    LTEXT           "HashCalc", IDC_LOGO, 7, 271, 70, 10
    DEFPUSHBUTTON   "Calculate", IDC_CALCULATE, 103, 268, 50, 15
    PUSHBUTTON      "Close", IDCANCEL, 157, 268, 50, 15
    PUSHBUTTON      "Help", IDC_HELPBTN, 211, 268, 50, 15
END

// Folder (bulk) hashing window: resizable, controls anchored in code.
IDD_FOLDERHASH DIALOGEX 0, 0, 380, 240
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
EXSTYLE WS_EX_ACCEPTFILES
CAPTION "Folder Hash"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Folder:", IDC_STATIC, 7, 9, 26, 8
    EDITTEXT        IDC_F_FOLDER, 36, 7, 315, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_F_BROWSE, 355, 7, 18, 13
    AUTOCHECKBOX    "Include subfolders", IDC_F_RECURSE, 7, 25, 80, 10
    LTEXT           "", IDC_F_ALGS, 92, 26, 281, 8, SS_ENDELLIPSIS
    CONTROL         "", IDC_F_LIST, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 40, 366, 150
    CONTROL         "", IDC_F_PROGRESS, "msctls_progress32", PBS_SMOOTH, 7, 195, 366, 6
    LTEXT           "", IDC_F_STATUS, 7, 205, 366, 8, SS_ENDELLIPSIS
    DEFPUSHBUTTON   "Start", IDC_F_START, 155, 219, 50, 14
    PUSHBUTTON      "Copy All", IDC_F_COPY, 209, 219, 50, 14
    PUSHBUTTON      "Export...", IDC_F_EXPORT, 263, 219, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 323, 219, 50, 14
END

// Settings > Add to PATH: where to copy HashCalc.exe (default C:\tools).
IDD_PATHSETUP DIALOGEX 0, 0, 260, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add HashCalc to PATH"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "HashCalc.exe will be copied to this folder, and the folder will be added to your PATH. Then you can type ""hashcalc"" in any new Command Prompt or PowerShell window.", IDC_STATIC, 7, 7, 246, 26
    LTEXT           "Folder:", IDC_STATIC, 7, 42, 26, 8
    EDITTEXT        IDC_P_FOLDER, 36, 40, 196, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_P_BROWSE, 235, 40, 18, 13
    LTEXT           "Your user PATH is changed, so no administrator rights are needed.", IDC_STATIC, 7, 59, 246, 8
    DEFPUSHBUTTON   "Add to PATH", IDOK, 149, 83, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 83, 50, 14
END
